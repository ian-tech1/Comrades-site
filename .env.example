# Supabase is the ONLY database and file-storage provider for this build.
# Project Settings -> Data API -> Project URL (NOT the database host beginning db.)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings -> API Keys -> Secret key (sb_secret_...). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_STORAGE_BUCKET=papers

# Generate a long random value (at least 32 characters).
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# First admin is created automatically when the API is first called.
ADMIN_NAME=Portal Administrator
ADMIN_EMAIL=admin@comreds.co.ke
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
DEFAULT_PAPER_PRICE=50
DEFAULT_PAYMENT_PHONE=+254723278526

# Safaricom Daraja. Keep sandbox until callback testing is complete.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=YOUR_SANDBOX_CONSUMER_KEY
DARAJA_CONSUMER_SECRET=YOUR_SANDBOX_CONSUMER_SECRET
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=YOUR_SANDBOX_PASSKEY
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_CALLBACK_URL=https://YOUR-VERCEL-DOMAIN/api/mpesa/callback
# Generate an independent 32+ character random value; the API adds it to the callback URL.
DARAJA_CALLBACK_TOKEN=REPLACE_WITH_A_LONG_RANDOM_CALLBACK_TOKEN
